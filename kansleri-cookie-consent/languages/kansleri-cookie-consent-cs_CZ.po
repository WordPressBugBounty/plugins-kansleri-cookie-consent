msgstr "Další kontrola: %s"

#: includes/class-admin.php:1075
msgid ""
"Also block tracking added in Bricks, Elementor, or other Custom Code fields"
msgstr ""
"Blokovat také sledování přidané v Bricks, Elementoru nebo jiných polích pro "
"vlastní kód"

