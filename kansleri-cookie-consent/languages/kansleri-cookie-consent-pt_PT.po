msgstr[0] ""
"%d cookie foi adicionado automaticamente com base nos scripts de "
"rastreamento detetados no seu site."
msgstr[1] ""
"%d cookies foram adicionados automaticamente com base nos scripts de "
"rastreamento detetados no seu site."

