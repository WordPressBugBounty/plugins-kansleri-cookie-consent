msgstr "Tilpasset valg"

#: includes/class-admin.php:920
msgid ""
"No consent data recorded yet. Statistics will appear after visitors start "
"interacting with the cookie banner."
msgstr ""
"Ingen samtykkedata er registrert ennå. Statistikken vises når besøkende "
"begynner å bruke banneret for informasjonskapsler."

