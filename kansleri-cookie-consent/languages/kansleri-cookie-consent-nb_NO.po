msgstr "Ugyldig JSON-format. Importer en gyldig array med informasjonskapsler."

#: includes/class-admin.php:75
msgid "Cookies imported into the table. Save cookies to persist changes."
msgstr ""
"Informasjonskapslene er importert i tabellen. Lagre informasjonskapsler for "
"å beholde endringene."

#: includes/class-admin.php:76
msgid "No valid cookies found in imported JSON."
msgstr "Fant ingen gyldige informasjonskapsler i den importerte JSON-en."

#: includes/class-admin.php:77
msgid "No cookie rows available to export."
msgstr "Ingen rader med informasjonskapsler å eksportere."

#: includes/class-admin.php:78
msgid "AI prompt copied to clipboard."
msgstr "KI-prompten er kopiert til utklippstavlen."

#: includes/class-admin.php:79
msgid ""
"Could not copy prompt automatically. Select all and copy from the box below."
msgstr ""
"Kunne ikke kopiere prompten automatisk. Merk alt og kopier fra boksen "
"nedenfor."

#: includes/class-admin.php:81
msgid "AI prompt (copied to clipboard — or select all and copy manually):"
msgstr ""
"KI-prompt (kopiert til utklippstavlen – eller merk alt og kopier manuelt):"

#: includes/class-admin.php:82
msgid ""
"Policy page AI prompt (copied to clipboard — or select all and copy "
"manually):"
msgstr ""
"KI-prompt for retningslinjesiden (kopiert til utklippstavlen – eller merk "
"alt og kopier manuelt):"

#: includes/class-admin.php:83
msgid ""
"Prompt ready below — select all (Ctrl+A) inside the box and copy (Ctrl+C)."
msgstr ""
"Prompten er klar nedenfor – merk alt (Ctrl+A) i boksen og kopier (Ctrl+C)."

#: includes/class-admin.php:80
msgid "All cookies are done! Every cookie has a description."
msgstr "Alt er ferdig! Alle informasjonskapsler har en beskrivelse."

#: includes/class-admin.php:81 includes/class-admin.php:457
msgid "No cookies registered yet."
msgstr "Ingen informasjonskapsler er registrert ennå."

#: includes/class-admin.php:82 includes/class-admin.php:473
msgid "Remove"
msgstr "Fjern"

#: includes/class-admin.php:83
msgid ""
"This will permanently delete all consent log records and statistics. "
"Continue?"
msgstr ""
"Dette sletter alle oppføringer i samtykkeloggen og all statistikk permanent. "
"Vil du fortsette?"

#: includes/class-admin.php:84 includes/class-admin.php:1150
msgid "All consent log records and statistics have been purged."
msgstr "Alle oppføringer i samtykkeloggen og all statistikk er slettet."

#: includes/class-admin.php:85
msgid "AI prompt for policy page copied to clipboard."
msgstr "KI-prompten for retningslinjesiden er kopiert til utklippstavlen."

#: includes/class-admin.php:86
msgid "CSS template copied to clipboard."
msgstr "CSS-malen er kopiert til utklippstavlen."

#: includes/class-admin.php:88
#, php-format
msgid "%d known cookie(s) added automatically:"
msgstr "Kjente informasjonskapsler lagt til automatisk (%d):"

#: includes/class-admin.php:90
#, php-format
msgid ""
"%d unknown cookie(s) added — please set their category and description "
"below."
msgstr ""
"Ukjente informasjonskapsler lagt til (%d) – angi kategori og beskrivelse for "
"dem nedenfor."

#: includes/class-admin.php:91
msgid "Unknown"
msgstr "Ukjente"

#: includes/class-admin.php:92
msgid "Added — categorize and describe in the table below"
msgstr "Lagt til – kategoriser og beskriv i tabellen nedenfor"

#: includes/class-admin.php:94
#, php-format
msgid "%d cookie(s) inferred from detected scripts on your site:"
msgstr ""
"Informasjonskapsler utledet fra oppdagede skript på nettstedet ditt (%d):"

#: includes/class-admin.php:95
msgid ""
"These cookies are expected from tracking scripts on your site, even when "
"blocked until consent."
msgstr ""
"Disse informasjonskapslene forventes fra sporingsskript på nettstedet ditt, "
"selv når de er blokkert frem til samtykke."

#: includes/class-admin.php:97
#, php-format
msgid ""
"%d browser cookie(s) skipped — found in your browser but no matching script "
"on this site:"
msgstr ""
"Informasjonskapsler i nettleseren som er hoppet over (%d) – funnet i "
"nettleseren din, men uten samsvarende skript på dette nettstedet:"

#: includes/class-admin.php:481
msgid ""
"%d cookie was automatically added based on tracking scripts detected on your"
" site."
msgid_plural ""
"%d cookies were automatically added based on tracking scripts detected on "
"your site."
msgstr[0] ""
"%d informasjonskapsel ble automatisk lagt til basert på sporingsskript som "
"er oppdaget på nettstedet ditt."
msgstr[1] ""
"%d informasjonskapsler ble automatisk lagt til basert på sporingsskript som "
"er oppdaget på nettstedet ditt."

