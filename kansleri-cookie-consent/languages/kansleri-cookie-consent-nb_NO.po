#: includes/class-admin.php:419
msgid "Need help describing these cookies?"
msgstr "Trenger du hjelp til å beskrive disse informasjonskapslene?"

#: includes/class-admin.php:421
msgid ""
"Click the button below to copy a ready-made AI prompt with your cookie data."
msgstr ""
"Klikk på knappen nedenfor for å kopiere en ferdig KI-prompt med dataene om "
"informasjonskapslene dine."

#: includes/class-admin.php:422
msgid "Paste the prompt into an AI tool (ChatGPT, Claude, Gemini, etc.)."
msgstr "Lim inn prompten i et KI-verktøy (ChatGPT, Claude, Gemini osv.)."

#: includes/class-admin.php:423
msgid "The AI will return improved JSON with clear cookie descriptions."
msgstr ""
"KI-en returnerer forbedret JSON med tydelige beskrivelser av "
"informasjonskapslene."

#: includes/class-admin.php:424
msgid ""
"Copy the AI response and paste it into the text box that appears below."
msgstr ""
"Kopier svaret fra KI-en og lim det inn i tekstboksen som vises nedenfor."

#: includes/class-admin.php:425
msgid "Click Import — cookies are saved automatically."
msgstr "Klikk «Importer» – informasjonskapslene lagres automatisk."

#: includes/class-admin.php:429
msgid "Copy AI Prompt to Clipboard"
msgstr "Kopier KI-prompt til utklippstavlen"

