msgstr "Nu există încă cookie-uri înregistrate."

#: includes/class-admin.php:82 includes/class-admin.php:473
msgid "Remove"
msgstr "Elimină"

#: includes/class-admin.php:83
msgid ""
"This will permanently delete all consent log records and statistics. "
"Continue?"
msgstr ""
"Toate înregistrările din jurnalul de consimțământ și toate statisticile vor "
"fi șterse definitiv. Continui?"

#: includes/class-admin.php:84 includes/class-admin.php:1150
msgid "All consent log records and statistics have been purged."
msgstr ""
"Toate înregistrările din jurnalul de consimțământ și statisticile au fost "
"șterse."

