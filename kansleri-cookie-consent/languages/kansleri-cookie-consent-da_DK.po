msgstr "Indsæt prompten i et AI-værktøj (ChatGPT, Claude, Gemini osv.)."

#: includes/class-admin.php:423
msgid "The AI will return improved JSON with clear cookie descriptions."
msgstr "AI'en returnerer forbedret JSON med tydelige cookiebeskrivelser."

#: includes/class-admin.php:424
msgid ""
"Copy the AI response and paste it into the text box that appears below."
msgstr "Kopiér AI'ens svar, og indsæt det i tekstfeltet, der vises nedenfor."

#: includes/class-admin.php:425
msgid "Click Import — cookies are saved automatically."
msgstr "Klik på Importér – cookies gemmes automatisk."

#: includes/class-admin.php:429
msgid "Copy AI Prompt to Clipboard"
msgstr "Kopiér AI-prompt til udklipsholderen"

