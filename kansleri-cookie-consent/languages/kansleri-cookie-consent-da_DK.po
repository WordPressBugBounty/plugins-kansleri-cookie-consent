msgstr "De valgte cookies er fjernet fra listen."

#: includes/class-admin.php:104
msgid "Remove selected cookies"
msgstr "Fjern valgte cookies"

#: includes/class-admin.php:1482
msgid ""
"None of the selected cookies can be removed. Run Scan Cookies again to "
"refresh the list."
msgstr ""
"Ingen af de valgte cookies kan fjernes. Kør Scan cookies igen for at "
