#, php-format
msgid "%d cookie(s) inferred from detected scripts on your site:"
msgstr "Cookies udledt af påviste scripts på websitet (%d):"

#: includes/class-admin.php:95
msgid ""
"These cookies are expected from tracking scripts on your site, even when "
"blocked until consent."
msgstr ""
"Disse cookies forventes at blive sat af sporingsscripts på websitet, også "
"når scriptsene er blokeret indtil samtykke."

#: includes/class-admin.php:97
#, php-format
msgid ""
"%d browser cookie(s) skipped — found in your browser but no matching script "
"on this site:"
msgstr ""
"Udeladte browsercookies (%d) – fundet i browseren, men uden tilsvarende "
"script på dette website:"

#: includes/class-admin.php:481
msgid ""
"%d cookie was automatically added based on tracking scripts detected on your"
" site."
msgid_plural ""
"%d cookies were automatically added based on tracking scripts detected on "
"your site."
msgstr[0] ""
"%d cookie blev tilføjet automatisk ud fra sporingsscripts, der er påvist på "
"websitet."
msgstr[1] ""
"%d cookies blev tilføjet automatisk ud fra sporingsscripts, der er påvist på "
"websitet."

