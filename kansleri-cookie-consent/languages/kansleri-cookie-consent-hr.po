msgstr "Prepoznati alati za praćenje"

#: includes/class-admin.php:1106
msgid "Script Handle"
msgstr "Handle skripte"

#: includes/class-admin.php:1024
msgid ""
"Individual consent records for GDPR audit compliance. Records are "
"automatically purged after the retention period (13 months)."
msgstr ""
"Pojedinačni zapisi o privolama za reviziju usklađenosti s GDPR-om. Zapisi se "
"automatski brišu nakon roka čuvanja (13 mjeseci)."

