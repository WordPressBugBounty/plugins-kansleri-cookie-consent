msgstr "Intercom: održava sesiju chat messengera i identitet posjetitelja."

#: includes/class-scanner.php:233
msgid "Crisp: keeps the chat session and visitor identity."
msgstr "Crisp: održava sesiju chata i identitet posjetitelja."

