#: includes/class-admin.php:122
msgid "Cookie Consent"
msgstr "Privolitev za piškotke"

#: includes/class-admin.php:67 includes/class-admin.php:1228
msgid "Settings saved."
msgstr "Nastavitve so shranjene."

#: includes/class-admin.php:68
msgid "An error occurred."
msgstr "Prišlo je do napake."

#: includes/class-admin.php:69
msgid "Scanning..."
msgstr "Pregledovanje …"

#: includes/class-admin.php:70
msgid "Scan complete."
msgstr "Pregled je končan."

#: includes/class-admin.php:71
msgid "No new cookies found."
msgstr "Ni bilo najdenih novih piškotkov."

#: includes/class-admin.php:72
msgid "Remove this cookie?"
msgstr "Želite odstraniti ta piškotek?"

#: includes/class-admin.php:73 includes/class-admin.php:414
#: includes/class-admin.php:698
msgid "Scan Cookies"
msgstr "Preglej piškotke"

#: includes/class-admin.php:74
msgid "Invalid JSON format. Please import a valid cookie array."
msgstr "Neveljavna oblika JSON. Uvozite veljavno polje piškotkov."

#: includes/class-admin.php:75
msgid "Cookies imported into the table. Save cookies to persist changes."
msgstr ""
"Piškotki so uvoženi v tabelo. Shranite piškotke, da se spremembe trajno "
"ohranijo."

#: includes/class-admin.php:76
msgid "No valid cookies found in imported JSON."
msgstr "V uvoženem JSON ni bilo najdenih veljavnih piškotkov."

#: includes/class-admin.php:77
msgid "No cookie rows available to export."
msgstr "Ni vrstic s piškotki za izvoz."

#: includes/class-admin.php:78
msgid "AI prompt copied to clipboard."
msgstr "Poziv UI je kopiran v odložišče."

#: includes/class-admin.php:79
msgid ""
"Could not copy prompt automatically. Select all and copy from the box below."
msgstr ""
"Poziva ni bilo mogoče samodejno kopirati. Izberite vse in kopirajte iz "
"spodnjega polja."

#: includes/class-admin.php:81
msgid "AI prompt (copied to clipboard — or select all and copy manually):"
msgstr "Poziv UI (kopiran v odložišče – ali izberite vse in kopirajte ročno):"

#: includes/class-admin.php:82
msgid ""
"Policy page AI prompt (copied to clipboard — or select all and copy "
"manually):"
msgstr ""
"Poziv UI za stran s politiko (kopiran v odložišče – ali izberite vse in "
"kopirajte ročno):"

#: includes/class-admin.php:83
msgid ""
"Prompt ready below — select all (Ctrl+A) inside the box and copy (Ctrl+C)."
msgstr ""
"Poziv je pripravljen spodaj – v polju izberite vse (Ctrl+A) in kopirajte "
"(Ctrl+C)."

#: includes/class-admin.php:80
msgid "All cookies are done! Every cookie has a description."
msgstr "Vsi piškotki so urejeni! Vsak piškotek ima opis."

#: includes/class-admin.php:81 includes/class-admin.php:457
msgid "No cookies registered yet."
msgstr "Noben piškotek še ni registriran."

#: includes/class-admin.php:82 includes/class-admin.php:473
msgid "Remove"
msgstr "Odstrani"

#: includes/class-admin.php:83
msgid ""
"This will permanently delete all consent log records and statistics. "
"Continue?"
msgstr ""
"S tem boste trajno izbrisali vse zapise v dnevniku privolitev in statistiko. "
"Želite nadaljevati?"

#: includes/class-admin.php:84 includes/class-admin.php:1150
msgid "All consent log records and statistics have been purged."
msgstr "Vsi zapisi v dnevniku privolitev in statistika so bili izbrisani."

#: includes/class-admin.php:85
msgid "AI prompt for policy page copied to clipboard."
msgstr "Poziv UI za stran s politiko je kopiran v odložišče."

#: includes/class-admin.php:86
msgid "CSS template copied to clipboard."
msgstr "Predloga CSS je kopirana v odložišče."

#: includes/class-admin.php:88
#, php-format
msgid "%d known cookie(s) added automatically:"
msgstr "Samodejno dodani znani piškotki (%d):"

#: includes/class-admin.php:90
#, php-format
msgid ""
"%d unknown cookie(s) added — please set their category and description "
"below."
msgstr "Dodani neznani piškotki (%d) – spodaj jim določite kategorijo in opis."

#: includes/class-admin.php:91
msgid "Unknown"
msgstr "Neznani"

#: includes/class-admin.php:92
msgid "Added — categorize and describe in the table below"
msgstr "Dodano – v spodnji tabeli določite kategorijo in opis"

#: includes/class-admin.php:94
#, php-format
msgid "%d cookie(s) inferred from detected scripts on your site:"
msgstr ""
"Piškotki, predvideni na podlagi skriptov, zaznanih na vašem spletnem mestu "
"(%d):"

#: includes/class-admin.php:95
msgid ""
"These cookies are expected from tracking scripts on your site, even when "
"blocked until consent."
msgstr ""
"Te piškotke je mogoče pričakovati zaradi sledilnih skriptov na vašem "
"spletnem mestu, tudi če so skripti do privolitve blokirani."

#: includes/class-admin.php:97
#, php-format
msgid ""
"%d browser cookie(s) skipped — found in your browser but no matching script "
"on this site:"
msgstr ""
"Preskočeni piškotki brskalnika (%d) – najdeni v vašem brskalniku, vendar "
"brez ustreznega skripta na tem spletnem mestu:"

#: includes/class-admin.php:481
msgid ""
"%d cookie was automatically added based on tracking scripts detected on your"
" site."
msgid_plural ""
"%d cookies were automatically added based on tracking scripts detected on "
"your site."
msgstr[0] ""
"%d piškotek je bil samodejno dodan na podlagi sledilnih skriptov, zaznanih "
"na vašem spletnem mestu."
msgstr[1] ""
"%d piškotka sta bila samodejno dodana na podlagi sledilnih skriptov, "
"zaznanih na vašem spletnem mestu."
msgstr[2] ""
"%d piškotki so bili samodejno dodani na podlagi sledilnih skriptov, zaznanih "
"na vašem spletnem mestu."
msgstr[3] ""
"%d piškotkov je bilo samodejno dodanih na podlagi sledilnih skriptov, "
"zaznanih na vašem spletnem mestu."

