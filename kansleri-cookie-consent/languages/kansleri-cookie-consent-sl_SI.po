msgstr "UI bo vrnila izboljšan JSON z jasnimi opisi piškotkov."

#: includes/class-admin.php:424
msgid ""
"Copy the AI response and paste it into the text box that appears below."
msgstr ""
"Kopirajte odgovor UI in ga prilepite v besedilno polje, ki se prikaže spodaj."

#: includes/class-admin.php:425
msgid "Click Import — cookies are saved automatically."
msgstr "Kliknite Uvozi – piškotki se shranijo samodejno."

