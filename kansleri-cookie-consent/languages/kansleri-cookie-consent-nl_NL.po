msgstr "%d cookie(s) afgeleid uit scripts die op je site zijn gevonden:"

#: includes/class-admin.php:95
msgid ""
"These cookies are expected from tracking scripts on your site, even when "
"blocked until consent."
msgstr ""
"Deze cookies worden verwacht van trackingscripts op je site, ook als die tot "
"de toestemming worden geblokkeerd."

