msgstr ""
"%d onbekende cookie(s) toegevoegd — stel hieronder hun categorie en "
"beschrijving in."

#: includes/class-admin.php:91
msgid "Unknown"
msgstr "Onbekend"

#: includes/class-admin.php:92
