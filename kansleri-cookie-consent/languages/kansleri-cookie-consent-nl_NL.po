msgid ""
"Prompt ready below — select all (Ctrl+A) inside the box and copy (Ctrl+C)."
msgstr ""
"De prompt staat hieronder klaar — selecteer alles (Ctrl+A) in het vak en "
"kopieer (Ctrl+C)."

#: includes/class-admin.php:80
msgid "All cookies are done! Every cookie has a description."
msgstr "Alle cookies zijn compleet! Elke cookie heeft een beschrijving."

#: includes/class-admin.php:81 includes/class-admin.php:457
msgid "No cookies registered yet."
msgstr "Nog geen cookies geregistreerd."

#: includes/class-admin.php:82 includes/class-admin.php:473
msgid "Remove"
msgstr "Verwijderen"

#: includes/class-admin.php:83
msgid ""
"This will permanently delete all consent log records and statistics. "
"Continue?"
msgstr ""
"Hiermee worden alle registraties in het toestemmingslogboek en alle "
"statistieken definitief verwijderd. Doorgaan?"

#: includes/class-admin.php:84 includes/class-admin.php:1150
msgid "All consent log records and statistics have been purged."
msgstr ""
"Alle registraties in het toestemmingslogboek en alle statistieken zijn "
"gewist."

