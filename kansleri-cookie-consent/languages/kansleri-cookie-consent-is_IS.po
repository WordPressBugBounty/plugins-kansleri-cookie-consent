msgstr "Þekktum vafrakökum bætt við sjálfkrafa (%d):"

#: includes/class-admin.php:90
#, php-format
msgid ""
"%d unknown cookie(s) added — please set their category and description "
"below."
msgstr ""
"Óþekktum vafrakökum bætt við (%d) – stilltu flokk og lýsingu þeirra hér "
"fyrir neðan."

#: includes/class-admin.php:91
msgid "Unknown"
msgstr "Óþekktar"

#: includes/class-admin.php:92
msgid "Added — categorize and describe in the table below"
msgstr "Bætt við – flokkaðu og lýstu í töflunni hér fyrir neðan"

#: includes/class-admin.php:94
#, php-format
msgid "%d cookie(s) inferred from detected scripts on your site:"
msgstr ""
"Vafrakökur sem búist er við út frá skriftum sem fundust á vefnum þínum (%d):"

#: includes/class-admin.php:95
msgid ""
"These cookies are expected from tracking scripts on your site, even when "
"blocked until consent."
msgstr ""
"Búist er við þessum vafrakökum frá rakningarskriftum á vefnum þínum, jafnvel "
"þótt þeim sé lokað þar til samþykki fæst."

#: includes/class-admin.php:97
#, php-format
msgid ""
"%d browser cookie(s) skipped — found in your browser but no matching script "
"on this site:"
msgstr ""
"Vafrakökum úr vafranum sleppt (%d) – fundust í vafranum þínum en engin "
"samsvarandi skrifta er á þessum vef:"

#: includes/class-admin.php:481
msgid ""
"%d cookie was automatically added based on tracking scripts detected on your"
" site."
msgid_plural ""
"%d cookies were automatically added based on tracking scripts detected on "
"your site."
msgstr[0] ""
"%d vafraköku var bætt sjálfkrafa við út frá rakningarskriftum sem fundust á "
"vefnum þínum."
msgstr[1] ""
"%d vafrakökum var bætt sjálfkrafa við út frá rakningarskriftum sem fundust á "
"vefnum þínum."

