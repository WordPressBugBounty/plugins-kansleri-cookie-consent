msgid "Script Handle"
msgstr "Handle skriftu"

#: includes/class-admin.php:1024
msgid ""
"Individual consent records for GDPR audit compliance. Records are "
"automatically purged after the retention period (13 months)."
msgstr ""
"Einstakar færslur um samþykki vegna úttekta samkvæmt GDPR. Færslum er eytt "
"sjálfkrafa að loknum varðveislutíma (13 mánuðum)."

