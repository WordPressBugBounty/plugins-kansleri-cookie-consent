#. translators: %s: the address the site owner entered
#: includes/class-script-blocker.php:195
#, php-format
msgid "“%s” is not a usable address. Use at least 4 characters without spaces, for example widget.example.com."
msgstr ""
"„%s” nie jest prawidłowym adresem. Użyj co najmniej 4 znaków bez spacji, na "
"przykład widget.example.com."

#. translators: %s: the address the site owner entered
#: includes/class-script-blocker.php:200
#, php-format
msgid "“%s” would block every script on this site. Enter the address of the external service instead."
msgstr ""
"„%s” zablokowałby wszystkie skrypty w tej witrynie. Zamiast tego wpisz adres "
"zewnętrznej usługi."

#: includes/class-script-blocker.php:840
msgid "This content is blocked because it requires analytics cookies."
msgstr ""
"Ta treść jest zablokowana, ponieważ wymaga analitycznych plików cookie."

#: includes/class-script-blocker.php:841
msgid "Accept analytics cookies"
msgstr "Zaakceptuj analityczne pliki cookie"

#: includes/class-script-blocker.php:845
msgid "This content is blocked because it requires preference cookies."
msgstr "Ta treść jest zablokowana, ponieważ wymaga plików cookie preferencji."

#: includes/class-script-blocker.php:846
msgid "Accept preference cookies"
msgstr "Zaakceptuj pliki cookie preferencji"

#: includes/class-admin.php:890 includes/class-admin.php:1203
msgid "Block by address"
msgstr "Blokuj według adresu"

#: includes/class-admin.php:1213
msgid "Scripts in page HTML are matched only while Custom Code blocking is on."
msgstr ""
"Skrypty w kodzie HTML strony są dopasowywane tylko wtedy, gdy włączone jest "
"blokowanie kodu niestandardowego."

#: includes/class-admin.php:1259 includes/class-admin.php:1289
msgid "Address contains"
msgstr "Adres zawiera"

#: includes/class-admin.php:1274
msgid "Add address"
msgstr "Dodaj adres"

#: includes/class-admin.php:1284
msgid "Necessary (never blocked)"
msgstr "Niezbędne (nigdy nie blokowane)"

#: includes/class-admin.php:889
msgid "Reviews widgets"
msgstr "Widżety opinii"

#: includes/class-admin.php:889
msgid "The Trustmary reviews widget waits for analytics consent, because it stores a visitor ID in the browser. A message with an accept button is shown in its place. To load it right away, add widget.trustmary.com under Block by address with the category “Necessary (never blocked)”."
msgstr ""
"Widżet opinii Trustmary czeka na zgodę na analitykę, ponieważ zapisuje w "
"przeglądarce identyfikator odwiedzającego. W jego miejscu wyświetlany jest "
"komunikat z przyciskiem akceptacji. Aby załadować go od razu, dodaj "
"widget.trustmary.com w sekcji Blokuj według adresu z kategorią „Niezbędne "
"(nigdy nie blokowane)”."

#: includes/class-admin.php:890
msgid "Blocks any other script by part of its address until the visitor accepts the category you choose, for example a widget the plugin does not recognize. Turn on Show message for scripts that show content on the page."
msgstr ""
"Blokuje dowolny inny skrypt na podstawie fragmentu jego adresu, dopóki "
"odwiedzający nie zaakceptuje wybranej kategorii, na przykład widżet, którego "
"wtyczka nie rozpoznaje. Włącz opcję Pokaż komunikat dla skryptów, które "
"wyświetlają treść na stronie."

#: includes/class-scanner.php:137
msgctxt "cookie duration"
msgid "Persistent"
msgstr "Trwały"

#: includes/class-scanner.php:209
msgid "Trustmary: stores a visitor ID, the landing page and conversions in the browser’s local storage."
msgstr ""
"Trustmary: zapisuje identyfikator odwiedzającego, stronę docelową i "
"konwersje w pamięci lokalnej przeglądarki."

#: includes/class-scanner.php:224
msgid "Reddit Pixel: identifies the browser for ad measurement."
msgstr "Reddit Pixel: identyfikuje przeglądarkę na potrzeby pomiaru reklam."

#: includes/class-scanner.php:225
msgid ""
"Microsoft Advertising: groups page views into a session for ad measurement."
msgstr ""
"Microsoft Advertising: grupuje wyświetlenia stron w sesję na potrzeby "
"pomiaru reklam."

#: includes/class-scanner.php:226
msgid ""
"Microsoft Advertising: identifies the visitor across visits for ad "
"measurement."
msgstr ""
"Microsoft Advertising: identyfikuje odwiedzającego między wizytami na "
"potrzeby pomiaru reklam."

#: includes/class-scanner.php:227
msgid "Criteo: stores a browser identifier for ad personalisation."
msgstr ""
"Criteo: zapisuje identyfikator przeglądarki na potrzeby personalizacji "
"reklam."

#: includes/class-scanner.php:228
msgid "Taboola: identifies the browser for ad targeting."
msgstr "Taboola: identyfikuje przeglądarkę w celu kierowania reklam."

#: includes/class-scanner.php:229
msgid "Klaviyo: recognises returning visitors for email marketing."
msgstr ""
"Klaviyo: rozpoznaje powracających odwiedzających na potrzeby e-mail "
"marketingu."

#: includes/class-scanner.php:230
msgid "Yandex Metrica: identifies visitors and stores session settings."
msgstr ""
"Yandex Metrica: identyfikuje odwiedzających i zapisuje ustawienia sesji."

#: includes/class-scanner.php:231
msgid "Segment: stores an anonymous visitor ID and traits."
msgstr "Segment: zapisuje anonimowy identyfikator odwiedzającego i jego cechy."

#: includes/class-scanner.php:232
msgid "Intercom: keeps the chat messenger session and visitor identity."
msgstr ""
"Intercom: utrzymuje sesję komunikatora czatu i tożsamość odwiedzającego."

#: includes/class-scanner.php:233
msgid "Crisp: keeps the chat session and visitor identity."
msgstr "Crisp: utrzymuje sesję czatu i tożsamość odwiedzającego."

