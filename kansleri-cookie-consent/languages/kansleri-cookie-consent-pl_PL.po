msgstr "Microsoft Clarity: łączy wyświetlenia stron w sesję."

#: includes/class-scanner.php:204
msgid "Stores your cookie consent preferences."
msgstr "Zapisuje Twoje preferencje dotyczące zgody na pliki cookie."

#: includes/class-scanner.php:205
msgid ""
"WP Consent API: stores your consent choice for necessary cookies. Synced "
"from your consent banner."
msgstr ""
"WP Consent API: zapisuje Twój wybór zgody dla niezbędnych plików cookie. "
"Synchronizowany z banera zgody."

#: includes/class-scanner.php:206
msgid ""
"WP Consent API: stores your consent choice for analytics cookies. Synced "
"from your consent banner."
msgstr ""
"WP Consent API: zapisuje Twój wybór zgody dla analitycznych plików cookie. "
"Synchronizowany z banera zgody."

#: includes/class-scanner.php:207
msgid ""
"WP Consent API: stores your consent choice for anonymous statistics. Synced "
"from your consent banner."
msgstr ""
"WP Consent API: zapisuje Twój wybór zgody dla anonimowych statystyk. "
"Synchronizowany z banera zgody."

#: includes/class-scanner.php:208
msgid ""
"WP Consent API: stores your consent choice for marketing cookies. Synced "
"from your consent banner."
msgstr ""
"WP Consent API: zapisuje Twój wybór zgody dla marketingowych plików cookie. "
"Synchronizowany z banera zgody."

#: includes/class-scanner.php:209
msgid ""
"WP Consent API: stores your consent choice for preference cookies. Synced "
"from your consent banner."
msgstr ""
"WP Consent API: zapisuje Twój wybór zgody dla plików cookie preferencji. "
"Synchronizowany z banera zgody."

#: includes/class-scanner.php:210
msgid ""
"WP Consent API: stores per-service consent overrides used by integrated "
