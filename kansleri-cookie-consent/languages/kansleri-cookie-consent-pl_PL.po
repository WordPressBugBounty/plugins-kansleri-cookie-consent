msgstr ""
"Nie udało się automatycznie skopiować promptu. Zaznacz wszystko i skopiuj z "
"pola poniżej."

#: includes/class-admin.php:81
msgid "AI prompt (copied to clipboard — or select all and copy manually):"
msgstr ""
"Prompt AI (skopiowany do schowka – lub zaznacz wszystko i skopiuj ręcznie):"

