msgstr "Intercom: uztur tērzēšanas rīka sesiju un apmeklētāja identitāti."

#: includes/class-scanner.php:233
msgid "Crisp: keeps the chat session and visitor identity."
msgstr "Crisp: uztur tērzēšanas sesiju un apmeklētāja identitāti."

