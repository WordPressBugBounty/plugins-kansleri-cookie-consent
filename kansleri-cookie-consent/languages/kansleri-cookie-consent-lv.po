#: includes/class-admin.php:95
msgid ""
"These cookies are expected from tracking scripts on your site, even when "
"blocked until consent."
msgstr ""
"Šīs sīkdatnes ir sagaidāmas no vietnes izsekošanas skriptiem, pat ja tie ir "
"bloķēti līdz piekrišanai."

#: includes/class-admin.php:97
#, php-format
msgid ""
"%d browser cookie(s) skipped — found in your browser but no matching script "
"on this site:"
msgstr ""
"Izlaistās pārlūka sīkdatnes (%d) – atrastas jūsu pārlūkā, bet vietnē nav "
"atbilstoša skripta:"

#: includes/class-admin.php:481
msgid ""
"%d cookie was automatically added based on tracking scripts detected on your"
" site."
msgid_plural ""
"%d cookies were automatically added based on tracking scripts detected on "
"your site."
msgstr[0] ""
"Automātiski pievienotas %d sīkdatnes, pamatojoties uz vietnē atrastajiem "
"izsekošanas skriptiem."
msgstr[1] ""
"Automātiski pievienota %d sīkdatne, pamatojoties uz vietnē atrastajiem "
"izsekošanas skriptiem."
msgstr[2] ""
"Automātiski pievienotas %d sīkdatnes, pamatojoties uz vietnē atrastajiem "
"izsekošanas skriptiem."

