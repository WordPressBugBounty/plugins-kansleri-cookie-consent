msgstr ""
"Prompt pre AI na stránku so zásadami (skopírovaný do schránky – alebo "
"označte všetko a skopírujte ručne):"

#: includes/class-admin.php:83
msgid ""
"Prompt ready below — select all (Ctrl+A) inside the box and copy (Ctrl+C)."
msgstr ""
"Prompt je pripravený nižšie – v poli označte všetko (Ctrl+A) a skopírujte "
"(Ctrl+C)."

#: includes/class-admin.php:80
msgid "All cookies are done! Every cookie has a description."
msgstr "Všetky súbory cookie sú hotové! Každý súbor cookie má popis."

#: includes/class-admin.php:81 includes/class-admin.php:457
msgid "No cookies registered yet."
msgstr "Zatiaľ nie sú zaregistrované žiadne súbory cookie."

#: includes/class-admin.php:82 includes/class-admin.php:473
msgid "Remove"
msgstr "Odstrániť"

#: includes/class-admin.php:83
msgid ""
"This will permanently delete all consent log records and statistics. "
"Continue?"
msgstr ""
"Týmto sa natrvalo vymažú všetky záznamy v protokole súhlasov a štatistiky. "
"Pokračovať?"

#: includes/class-admin.php:84 includes/class-admin.php:1150
msgid "All consent log records and statistics have been purged."
msgstr "Všetky záznamy v protokole súhlasov a štatistiky boli vymazané."

