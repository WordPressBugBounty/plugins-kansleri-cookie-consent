#, php-format
msgid "%d known cookie(s) added automatically:"
msgstr "%d cookie(s) connu(s) ajouté(s) automatiquement :"

#: includes/class-admin.php:90
#, php-format
msgid ""
"%d unknown cookie(s) added — please set their category and description "
"below."
msgstr ""
"%d cookie(s) inconnu(s) ajouté(s) — veuillez définir leur catégorie et leur "
"description ci-dessous."

#: includes/class-admin.php:91
msgid "Unknown"
msgstr "Inconnu"

#: includes/class-admin.php:92
msgid "Added — categorize and describe in the table below"
msgstr "Ajouté — à catégoriser et à décrire dans le tableau ci-dessous"

