#, php-format
msgid "%d cookie(s) inferred from detected scripts on your site:"
msgstr "%d cookie(s) déduit(s) des scripts détectés sur votre site :"

#: includes/class-admin.php:95
msgid ""
"These cookies are expected from tracking scripts on your site, even when "
"blocked until consent."
msgstr ""
"Ces cookies sont normalement déposés par les scripts de suivi de votre site, "
"même lorsque ceux-ci sont bloqués jusqu’au consentement."

#: includes/class-admin.php:97
#, php-format
msgid ""
"%d browser cookie(s) skipped — found in your browser but no matching script "
"on this site:"
msgstr ""
"%d cookie(s) du navigateur ignoré(s) — présent(s) dans votre navigateur, "
"mais sans script correspondant sur ce site :"

#: includes/class-admin.php:481
msgid ""
"%d cookie was automatically added based on tracking scripts detected on your"
" site."
msgid_plural ""
"%d cookies were automatically added based on tracking scripts detected on "
"your site."
msgstr[0] ""
"%d cookie a été ajouté automatiquement à partir des scripts de suivi "
"détectés sur votre site."
msgstr[1] ""
"%d cookies ont été ajoutés automatiquement à partir des scripts de suivi "
"détectés sur votre site."

