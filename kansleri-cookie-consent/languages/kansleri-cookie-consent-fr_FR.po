msgid ""
"Could not copy prompt automatically. Select all and copy from the box below."
msgstr ""
"Impossible de copier le prompt automatiquement. Sélectionnez tout le contenu "
"de la zone ci-dessous et copiez-le."

#: includes/class-admin.php:81
msgid "AI prompt (copied to clipboard — or select all and copy manually):"
msgstr ""
