msgstr "CSS-mallen har kopierats till urklipp."

#: includes/class-admin.php:88
#, php-format
msgid "%d known cookie(s) added automatically:"
msgstr "Kända cookies har lagts till automatiskt (%d):"

#: includes/class-admin.php:90
#, php-format
msgid ""
"%d unknown cookie(s) added — please set their category and description "
"below."
msgstr ""
"Okända cookies har lagts till (%d) – ange kategori och beskrivning för dem "
"nedan."

#: includes/class-admin.php:91
msgid "Unknown"
msgstr "Okänd"

#: includes/class-admin.php:92
msgid "Added — categorize and describe in the table below"
msgstr "Tillagd – kategorisera och beskriv i tabellen nedan"

#: includes/class-admin.php:94
#, php-format
msgid "%d cookie(s) inferred from detected scripts on your site:"
msgstr "Cookies som härletts från upptäckta skript på din webbplats (%d):"

#: includes/class-admin.php:95
msgid ""
"These cookies are expected from tracking scripts on your site, even when "
"blocked until consent."
msgstr ""
"Dessa cookies förväntas komma från spårningsskript på din webbplats, även "
"när de blockeras tills samtycke ges."

#: includes/class-admin.php:97
#, php-format
msgid ""
"%d browser cookie(s) skipped — found in your browser but no matching script "
"on this site:"
msgstr ""
"Webbläsarcookies som hoppades över (%d) – hittades i din webbläsare men "
"inget matchande skript finns på den här webbplatsen:"

#: includes/class-admin.php:481
msgid ""
"%d cookie was automatically added based on tracking scripts detected on your"
" site."
msgid_plural ""
"%d cookies were automatically added based on tracking scripts detected on "
"your site."
msgstr[0] ""
"%d cookie har lagts till automatiskt utifrån spårningsskript som upptäckts "
"på din webbplats."
msgstr[1] ""
"%d cookies har lagts till automatiskt utifrån spårningsskript som upptäckts "
"på din webbplats."

