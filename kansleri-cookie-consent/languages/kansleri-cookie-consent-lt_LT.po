msgstr "Automatiškai pridėti žinomi slapukai (%d):"

#: includes/class-admin.php:90
#, php-format
msgid ""
"%d unknown cookie(s) added — please set their category and description "
"below."
msgstr ""
"Pridėti nežinomi slapukai (%d) – žemiau nurodykite jų kategoriją ir aprašymą."

#: includes/class-admin.php:91
msgid "Unknown"
msgstr "Nežinomi"

#: includes/class-admin.php:92
msgid "Added — categorize and describe in the table below"
msgstr "Pridėta – lentelėje žemiau priskirkite kategoriją ir aprašymą"

#: includes/class-admin.php:94
#, php-format
msgid "%d cookie(s) inferred from detected scripts on your site:"
msgstr "Pagal jūsų svetainėje aptiktus scenarijus numatyti slapukai (%d):"

#: includes/class-admin.php:95
msgid ""
"These cookies are expected from tracking scripts on your site, even when "
"blocked until consent."
msgstr ""
"Tikėtina, kad šiuos slapukus nustatys jūsų svetainės sekimo scenarijai, net "
"jei iki sutikimo jie blokuojami."

#: includes/class-admin.php:97
#, php-format
msgid ""
"%d browser cookie(s) skipped — found in your browser but no matching script "
"on this site:"
msgstr ""
"Praleisti naršyklės slapukai (%d) – rasti jūsų naršyklėje, bet šioje "
"svetainėje nėra juos atitinkančio scenarijaus:"

#: includes/class-admin.php:481
msgid ""
"%d cookie was automatically added based on tracking scripts detected on your"
" site."
msgid_plural ""
"%d cookies were automatically added based on tracking scripts detected on "
"your site."
msgstr[0] ""
"%d slapukas buvo automatiškai pridėtas pagal jūsų svetainėje aptiktus sekimo "
"scenarijus."
msgstr[1] ""
"%d slapukai buvo automatiškai pridėti pagal jūsų svetainėje aptiktus sekimo "
"scenarijus."
msgstr[2] ""
"%d slapukų buvo automatiškai pridėta pagal jūsų svetainėje aptiktus sekimo "
"scenarijus."

