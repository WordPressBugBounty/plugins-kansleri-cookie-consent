#: includes/class-admin.php:421
msgid ""
"Click the button below to copy a ready-made AI prompt with your cookie data."
msgstr ""
"Spustelėkite žemiau esantį mygtuką, kad nukopijuotumėte paruoštą DI užklausą "
"su jūsų slapukų duomenimis."

#: includes/class-admin.php:422
