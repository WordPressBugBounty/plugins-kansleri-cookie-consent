msgstr "Richtlinienversion"

#: includes/class-admin.php:1311
msgid "Cookies saved."
msgstr "Cookies gespeichert."

#: includes/class-consent.php:135
msgid "Cookie consent"
msgstr "Cookie-Einwilligung"

#: includes/class-consent.php:147 includes/class-policy-page.php:27
msgid "Cookie Policy"
msgstr "Cookie-Richtlinie"

