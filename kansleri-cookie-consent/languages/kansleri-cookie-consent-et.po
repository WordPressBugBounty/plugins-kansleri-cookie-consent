msgstr "CSS-mall kopeeriti lõikelauale."

#: includes/class-admin.php:88
#, php-format
msgid "%d known cookie(s) added automatically:"
msgstr "Automaatselt lisatud tuntud küpsised (%d):"

#: includes/class-admin.php:90
#, php-format
msgid ""
"%d unknown cookie(s) added — please set their category and description "
"below."
msgstr ""
"Lisatud tundmatud küpsised (%d) – määrake allpool nende kategooria ja "
"kirjeldus."

#: includes/class-admin.php:91
msgid "Unknown"
msgstr "Tundmatud"

#: includes/class-admin.php:92
msgid "Added — categorize and describe in the table below"
msgstr "Lisatud – määrake kategooria ja kirjeldus allolevas tabelis"

#: includes/class-admin.php:94
#, php-format
msgid "%d cookie(s) inferred from detected scripts on your site:"
msgstr "Teie veebisaidil tuvastatud skriptide põhjal tuletatud küpsised (%d):"

#: includes/class-admin.php:95
msgid ""
"These cookies are expected from tracking scripts on your site, even when "
"blocked until consent."
msgstr ""
"Neid küpsiseid on oodata teie veebisaidi jälgimisskriptidelt ka siis, kui "
"skriptid on kuni nõusolekuni blokeeritud."

#: includes/class-admin.php:97
#, php-format
msgid ""
"%d browser cookie(s) skipped — found in your browser but no matching script "
"on this site:"
msgstr ""
"Vahele jäetud brauseri küpsised (%d) – leitud teie brauserist, kuid sellel "
"veebisaidil pole vastavat skripti:"

#: includes/class-admin.php:481
msgid ""
"%d cookie was automatically added based on tracking scripts detected on your"
" site."
msgid_plural ""
"%d cookies were automatically added based on tracking scripts detected on "
"your site."
msgstr[0] ""
"%d küpsis lisati automaatselt teie veebisaidil tuvastatud jälgimisskriptide "
"põhjal."
msgstr[1] ""
"%d küpsist lisati automaatselt teie veebisaidil tuvastatud jälgimisskriptide "
"põhjal."

